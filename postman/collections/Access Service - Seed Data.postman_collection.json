  "item": [
    {
      "name": "Resources",
      "item": [
        {
          "name": "Create Resource Seed",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{$randomCompanyName}}\",\r\n  \"type\": \"postgres\",\r\n  \"attributes\": {\r\n    \"host\": \"{{$randomDomainName}}\",\r\n    \"port\": 5432,\r\n    \"env\": \"prod\"\r\n  }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{gateway_prefix}}/api/v1/resources",
              "host": [
                "{{base_url}}{{gateway_prefix}}"
              ],
              "path": [
                "api",
                "v1",
                "resources"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
