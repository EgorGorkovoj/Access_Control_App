              "mode": "raw",
              "raw": "{\r\n  \"name\": \"access-{{$randomUUID}}\",\r\n  \"description\": \"{{$randomPhrase}}\",\r\n  \"resource_id\": {{resource_id}},\r\n  \"credentials\": {\r\n    \"host\": \"{{$randomDomainName}}\",\r\n    \"username\": \"{{$randomUserName}}\"\r\n  }\r\n}",
              "options": {
                "raw": {
